{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "*": ["./*"],
      "@components/*": ["./components/*"],
      "@lib/*": ["./lib/*"],
      "@icons/*": ["./icons/*"]
    },

    "moduleResolution": "node",
    "module": "esnext",
    "target": "esnext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },

  "exclude": ["node_modules"]
}
