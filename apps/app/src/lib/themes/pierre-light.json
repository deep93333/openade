        "support.variable.object.node"
      ],
      "settings": { "foreground": "#d47628" }
    },
    {
      "scope": "variable.language",
      "settings": { "foreground": "#d5a910" }
    },
    {
      "scope": "variable.parameter.function",
      "settings": { "foreground": "#79797F" }
    },
    {
      "scope": "function.parameter",
      "settings": { "foreground": "#79797F" }
