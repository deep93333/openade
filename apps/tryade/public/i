#!/usr/bin/env bash
set -euo pipefail
if command -v npx >/dev/null 2>&1 && npx --yes tryade "$@"; then
  exit 0
fi
echo "Using shell installer (no npx or CLI not on registry yet)…" >&2
URL="${OPENADE_INSTALL_SCRIPT_URL:-${AGENTIDE_INSTALL_SCRIPT_URL:-https://tryade.dev/install.sh}}"
curl -fsSL "$URL" | bash -s -- "$@"
